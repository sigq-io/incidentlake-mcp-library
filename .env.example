# URL of the SIGQ backend public API (no trailing slash)
SIGQ_API_URL=http://localhost:3000/incidentlake/public-api

# Bearer token generated from SIGQ tenant settings (sigq_ prefix)
SIGQ_API_TOKEN=sigq_your_token_here

# Optional. Tool groups to register on top of the core tools (see README "Tool groups").
# Comma-separated feature names, or "all" / "none". Unset = incidents,task_board
# SIGQ_TOOLSETS=incidents,task_board,specs
